{
  "name": "latmanga",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "scrap": "bun src/commands/scrap.ts",
    "sanitize": "bun src/commands/sanitize.ts",
    "update-users-also-read": "bun src/commands/update-users-also-read.ts",
    "start": "bunx prisma generate && bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "format": "bunx @biomejs/biome format --write ./src",
    "lint": "bunx @biomejs/biome check --write ./src",
    "lint:check": "bunx @biomejs/biome check ./src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe ./src",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/markdown-it": "^14.1.2",
    "@types/slug": "^5.0.9",
