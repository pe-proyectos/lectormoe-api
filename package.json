    "bun-types": "^1.3.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/eden": "^1.4.6",
    "@elysiajs/jwt": "^1.4.0",
    "@grotto/logysia": "^0.1.6",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "7.2.0",
    "@types/nodemailer": "^7.0.4",
    "@types/paypal__checkout-server-sdk": "^1.0.8",
    "@types/pg": "^8.16.0",
    "@types/ua-parser-js": "^0.7.39",
    "buffer-image-size": "^0.6.4",
    "canvas": "^3.2.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "elysia": "1.4.21",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "isomorphic-dompurify": "^3.10.0",
