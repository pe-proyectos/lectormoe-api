generator client {
  provider               = "prisma-client"
  output                 = "../src/prisma-generated"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Token {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("token")
}

model Organization {
  id                                           Int                       @id @default(autoincrement())
  name                                         String                    @db.VarChar(256)
  title                                        String                    @db.VarChar(256)
  domain                                       String                    @unique @db.VarChar(256)
  slug                                         String                    @unique @db.VarChar(256)
  description                                  String?
  imageUrl                                     String?
  createdAt                                    DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                                    DateTime                  @updatedAt
  googleAdsMetaContent                         String?
  googleAdsAdsTxtContent                       String?
  bannerUrl                                    String?
  discordUrl                                   String?
  facebookUrl                                  String?
  instagramUrl                                 String?
  logoUrl                                      String?
  patreonUrl                                   String?
  tiktokUrl                                    String?
  twitchUrl                                    String?
  twitterUrl                                   String?
  youtubeUrl                                   String?
  enableGoogleAds                              Boolean                   @default(false)
  faviconUrl                                   String?
  enableMangaSection                           Boolean                   @default(true)
  enableManhuaSection                          Boolean                   @default(false)
  enableManhwaSection                          Boolean                   @default(false)
  language                                     String                    @default("es") @db.VarChar(2)
  monitorWebsiteId                             String?
  useAllowedCountries                          Boolean                   @default(false)
  useBlockedCountries                          Boolean                   @default(false)
  adsterraAdSource                             String?
  enableAdsterraAds                            Boolean                   @default(false)
  enableMainBanner                             Boolean                   @default(false)
  enableMainSlider                             Boolean                   @default(false)
  enableSubscriptionSection                    Boolean                   @default(false)
  discordWebhookUrlNewChapter                  String?
  discordWebhookUrlNewSubscription             String?
  enableDiscordWebhookNewChapter               Boolean                   @default(false)
  enableDiscordWebhookNewSubscription          Boolean                   @default(false)
  discordWebhookMessageTemplateNewChapter      String?
  discordWebhookMessageTemplateNewSubscription String?
  isPublic                                     Boolean                   @default(true)
  isNSFW                                       Boolean                   @default(false)
  isDeleted                                    Boolean                   @default(false)
  enableAds                                    Boolean                   @default(false)
  analytics                                    Analytics[]
  audits                                       Audit[]
  comments                                     Comment[]
  commentLikes                                 CommentLike[]
  countryOptions                               CountryOptions[]
  genres                                       Genre[]
  mangaCustoms                                 MangaCustom[]
  followers                                    OrganizationFollower[]
  OrganizationTransaction                      OrganizationTransaction[]
  passwordResetTokens                          PasswordResetToken[]
  permissions                                  Permission[]
  rankings                                     Ranking[]
  subscriptions                                Subscription[]
  subscriptionPlans                            SubscriptionPlan[]
  jointMembers                                 JointMember[]
  uploadedJointChapters                        Chapter[]     @relation("ChapterUploader")
  workedOnJointChapters                        Chapter[]     @relation("ChapterWorkedBy")
  notifications                                Notification[]
  jointMemberHistory                           JointMemberHistory[]
  userBans                                     UserBan[]
  messageThreads                               OrganizationMessageThread[]
  recruitmentPosts                             RecruitmentPost[]
  communityPosts                               OrganizationPost[]
  organizationRecommendations                  OrganizationRecommendation[]

  @@map("organization")
}

model RecruitmentPost {
  id             Int          @id @default(autoincrement())
  organizationId Int
  title          String       @db.VarChar(200)
  description    String       @db.VarChar(4000)
  requirements   String?      @db.VarChar(2000)
  roles          String       @db.VarChar(300)
  language       String       @default("es") @db.VarChar(8)
  urgent         Boolean      @default(false)
  status         String       @default("open") @db.VarChar(16)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, urgent, updatedAt])
  @@index([organizationId, status])
  @@map("recruitment_post")
}

// Publicaciones de comunidad de un scan (tab /socials estilo YouTube/FB):
// avances, avisos, FAQ. Autoria del staff; likes de cualquier usuario; los
// comentarios reutilizan la tabla `comment` con identifier `post-<id>`.
model OrganizationPost {
  id             Int           @id @default(autoincrement())
  organizationId Int?
  userId         Int
  content        String        @db.Text
  images         Json?
  pinned         Boolean       @default(false)
  parentId       Int?
  repostOfId     Int?
  likesCount     Int           @default(0)
  commentsCount  Int           @default(0)
  repostCount    Int           @default(0)
  isSpoiler      Boolean       @default(false)
  isSensitive    Boolean       @default(false)
  spoilerOfMangaCustomId Int?
  spoilerChapter Float?
  workMangaCustomId Int?
  reportsCount   Int           @default(0)
  hiddenReason   String?       @db.VarChar(32)
  hiddenByUserId Int?
  deletedAt      DateTime?
  hiddenAt       DateTime?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         OrganizationPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        OrganizationPost[] @relation("PostReplies")
  repostOf       OrganizationPost?  @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts        OrganizationPost[] @relation("PostReposts")
  likes          OrganizationPostLike[]
  saves          OrganizationPostSave[]
  hashtags       OrganizationPostHashtag[]
  poll           PostPoll?

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
  @@map("organization_post")
}

model OrganizationPostLike {
  id        Int              @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime         @default(now()) @db.Timestamp(6)
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("organization_post_like")
}

model OrganizationPostSave {
  id        Int              @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime         @default(now()) @db.Timestamp(6)
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("organization_post_save")
}

model OrganizationPostHashtag {
  id        Int              @id @default(autoincrement())
  postId    Int
  tag       String           @db.VarChar(80)
  createdAt DateTime         @default(now()) @db.Timestamp(6)
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([tag, createdAt])
  @@index([postId])
  @@map("organization_post_hashtag")
}

// "Estante curado del scan": recomendaciones editoriales que el propio scan
// pone en grande en su landing ("La recomendación de la casa"). Cada una apunta
// a una obra (mangaCustom o joint), con etiqueta y nota libres, orden, activo,
// y opción de aparecer en el home global. Ventana de fechas opcional.
model OrganizationRecommendation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  mangaCustomId  Int?
  jointId        Int?
  label          String       @default("La recomendación de la casa") @db.VarChar(80)
  note           String?      @db.VarChar(500)
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  showOnGlobal   Boolean      @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mangaCustom    MangaCustom? @relation(fields: [mangaCustomId], references: [id], onDelete: Cascade)
  joint          MangaJoint?  @relation(fields: [jointId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive, position])
  @@index([showOnGlobal, isActive])
  @@map("organization_recommendation")
}

model User {
  id                      Int                      @id @default(autoincrement())
  username                String                   @unique @db.VarChar(256)
  slug                    String                   @unique @db.VarChar(256)
  email                   String                   @unique @db.VarChar(256)
  password                String                   @db.VarChar(256)
  createdAt               DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                 @updatedAt
  description             String?
  imageUrl                String?
  birthdate               DateTime?
  bannerUrl               String?
  bannerUrlChangedAt      DateTime?
  imageUrlChangedAt       DateTime?
  usernameChangedAt       DateTime?
  emailNotifications      Boolean                  @default(true)
  emailVerified           Boolean                  @default(false)
  deletedAt               DateTime?
  isPrivateHistory        Boolean                  @default(false)
  isPublicProfile         Boolean                  @default(true)
  pushNotifications       Boolean                  @default(true)
  notifyCommentsOnOwnedContent Boolean             @default(true)
  // Global no-ads override (admins, giveaway prizes, etc.). Independent of
  // subscriptions — applies on every page regardless of plan / scan.
  hideAds                 Boolean                  @default(false)
  theme                   String                   @default("dark") @db.VarChar(20)
  discordId           String?    @unique @db.VarChar(64)
  discordUsername     String?    @db.VarChar(64)
  discordAvatar       String?    @db.VarChar(64)
  discordVerifiedAt   DateTime?
  discordLastCheckAt  DateTime?
  analytics               Analytics[]
  audits                  Audit[]
  Comment                 Comment[]                @relation("HiddenByUser")
  comments                Comment[]
  emailLogs               EmailLog[]
  emailPreference         EmailPreference?
  emailVerificationTokens EmailVerificationToken[]
  favorites               Favorite[]
  userList                UserList[]
  pageBookmarks           UserPageBookmark[]
  organizationFollows     OrganizationFollower[]
  communityPosts          OrganizationPost[]
  passwordResetTokens     PasswordResetToken[]
  permissions             Permission[]
  rankings                Ranking[]
  subscriptions           Subscription[]
  tokens                  Token[]
  unsubscribeTokens       UnsubscribeToken[]
  achievements            UserAchievement[]
  history                 UserChapterHistory[]
  dailyActivities         UserDailyActivity[]
  notifications           Notification[]
  raffleTickets           RaffleTicket[]
  raffleComments          RaffleComment[]
  bansReceived            UserBan[]            @relation("BannedUser")
  bansIssued              UserBan[]            @relation("BannedByUser")
  chapterReactions        ChapterReaction[]
  milestoneAlerts         ChapterMilestoneAlert[]
  reviews                 MangaReview[]           @relation("MangaReviewUser")
  reviewsHidden           MangaReview[]           @relation("MangaReviewHiddenBy")
  contentReports          ContentReport[]         @relation("ContentReportReporter")
  customLists             CustomList[]
  customListFollows       CustomListFollower[]
  customListFollowerItems CustomListFollowerItem[]
  messageThreads          OrganizationMessageThread[]
  organizationMessages    OrganizationMessage[]
  listIsPublic            Boolean                  @default(true)
  savedQuotesPublic       Boolean                  @default(true)
  followersCount          Int                      @default(0)
  followingCount          Int                      @default(0)
  postsCount              Int                      @default(0)
  contentReportsReviewed  ContentReport[]         @relation("ContentReportReviewer")
  moderationLogs          ModerationLog[]
  organizationRequests    OrganizationRequest[]
  betaTester              BetaTester?

  @@map("user")
  savedQuotes             UserSavedQuote[]
}

// Inscripción al programa de pruebas cerradas de Google Play. Cada usuario
// (logueado) se registra una vez con el correo de Google que usa en su celular
// Android. El staff lo administra desde el superadmin y lo agrega a la lista de
// verificadores de Play Console.
model BetaTester {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(256)
  gmail     String   @db.VarChar(256)
  // pending = registrado, aún no agregado a Play; added = ya en la lista;
  // rejected = descartado.
  status    String   @default("pending") @db.VarChar(20)
  note      String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  @@map("beta_tester")
}

model ModerationLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String   @db.VarChar(64)
  targetType  String   @db.VarChar(32)
  targetId    Int
  details     String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
  @@map("moderation_log")
}

model Permission {
  id                        Int          @id @default(autoincrement())
  userId                    Int
  organizationId            Int
  canCreateAuthor           Boolean      @default(false)
  canCreateChapter          Boolean      @default(false)
  canCreateGenre            Boolean      @default(false)
  canCreateMangaCustom      Boolean      @default(false)
  canCreateMangaProfile     Boolean      @default(false)
  canCreatePage             Boolean      @default(false)
  canDeleteChapter          Boolean      @default(false)
  canDeleteGenre            Boolean      @default(false)
  canDeleteMangaCustom      Boolean      @default(false)
  canDeleteOrganization     Boolean      @default(false)
  canDeletePage             Boolean      @default(false)
  canEditChapter            Boolean      @default(false)
  canEditGenre              Boolean      @default(false)
  canEditMangaCustom        Boolean      @default(false)
  canEditOrganization       Boolean      @default(false)
  canEditPage               Boolean      @default(false)
  canSeeAdminPanel          Boolean      @default(false)
  hierarchyLevel            Int          @default(0)
  role                      String       @default("user") @db.VarChar(256)
  canDeleteUser             Boolean      @default(false)
  canEditUser               Boolean      @default(false)
  canCreateSubscriptionPlan Boolean      @default(false)
  canDeleteSubscriptionPlan Boolean      @default(false)
  canEditSubscriptionPlan   Boolean      @default(false)
  canDownload               Boolean      @default(false)
  canReadUnreleased         Boolean      @default(false)
  hideAds                   Boolean      @default(false)
  canDeleteComment          Boolean      @default(false)
  canEditComment            Boolean      @default(false)
  canHideComment            Boolean      @default(false)
  canBanUser                Boolean      @default(false)
  createdAt                 DateTime     @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("permission")
}

model PasswordResetToken {
  id             Int           @id @default(autoincrement())
  userId         Int
  token          String        @unique
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("password_reset_token")
}

model CountryOptions {
  id             Int          @id @default(autoincrement())
  organizationId Int
  countryCode    String       @db.VarChar(2)
  language       String       @db.VarChar(2)
  countryName    String       @db.VarChar(256)
  allowed        Boolean      @default(true)
  blocked        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, countryCode])
  @@map("country_options")
}

model Author {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(256)
  slug             String   @unique @db.VarChar(256)
  shortDescription String?  @db.VarChar(300)
  description      String?
  imageUrl         String?
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @updatedAt
  mangas           Manga[]  @relation("AuthorToManga")

  @@map("author")
}

model BookType {
  id                Int     @id @default(autoincrement())
  name              String  @db.VarChar(256)
  default_read_type String?
  code              String  @unique @db.VarChar(256)
  Manga             Manga[]

  @@map("book_type")
}

model Manga {
  id               Int           @id @default(autoincrement())
  demographyId     Int
  title            String        @unique @db.VarChar(256)
  slug             String        @unique @db.VarChar(256)
  shortDescription String?       @db.VarChar(300)
  description      String?
  imageUrl         String?
  releasedAt       DateTime?
  nextChapterAt    DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt
  bannerUrl        String?
  bookTypeId       Int
  bookType         BookType      @relation(fields: [bookTypeId], references: [id])
  demography       Demography    @relation(fields: [demographyId], references: [id])
  custom           MangaCustom[]
  joints           MangaJoint[]
  authors          Author[]      @relation("AuthorToManga")

  @@map("manga")
}

model MangaCustom {
  id                                 Int                @id @default(autoincrement())
  mangaId                            Int
  organizationId                     Int
  title                              String             @db.VarChar(256)
  // Título alternativo/original (p. ej. el nombre en japonés/romaji) que el
  // scan puede poner para SEO y para que se encuentre más fácil. Se muestra
  // debajo del título custom en la ficha.
  alternativeTitle                   String?            @db.VarChar(256)
  shortDescription                   String?            @db.VarChar(300)
  description                        String?
  imageUrl                           String?
  releasedAt                         DateTime?
  nextChapterAt                      DateTime?
  createdAt                          DateTime           @default(now()) @db.Timestamp(6)
  updatedAt                          DateTime           @updatedAt
  views                              Int                @default(0)
  lastChapterAt                      DateTime?
  status                             String             @default("ongoing") @db.VarChar(256)
  visibility                         String             @default("public") @db.VarChar(256)
  bannerUrl                          String?
  requireLogin                       Boolean            @default(false)
  isSimulRelease                     Boolean            @default(false)
  isNSFW                             Boolean            @default(false)
  // Caso copyright: si es true, los usuarios DESLOGUEADOS solo reciben las
  // páginas difuminadas (Page.blurUrl), nunca las originales. Se activa a mano
  // solo en obras con disputa de copyright para proteger los anuncios.
  loggedInOnly                       Boolean            @default(false)
  // Obra pública. Si es false: se oculta de TODO listado/búsqueda/home público;
  // solo el STAFF del scan puede verla (para retirar contenido con copyright); y
  // se DESACTIVAN los anuncios en sus páginas mientras esté en privado.
  isPublic                           Boolean            @default(true)
  workType                           String             @default("manga") @db.VarChar(32)
  deletedAt                          DateTime?
  nextChapterAtMessage               String?
  hideUnreleasedChapters             Boolean            @default(false)
  usersAlsoReadMangaCustomIds        String?
  finalChapterNumber                 Float?
  groupChaptersByVolume              Boolean            @default(false)
  // Obra de un solo capítulo (one-shot). Es un flag de la obra, no un género.
  isOneShot                          Boolean            @default(false)
  chapters                           Chapter[]
  volumes                            MangaVolume[]
  milestoneAlerts                    ChapterMilestoneAlert[]
  reviews                            MangaReview[]
  contentReports                     ContentReport[]
  customListItems                    CustomListItem[]
  favorites                          Favorite[]
  userListEntries                    UserList[]
  manga                              Manga              @relation(fields: [mangaId], references: [id])
  organization                       Organization       @relation(fields: [organizationId], references: [id])
  rankings                           Ranking[]
  viewsHistory                       ViewsHistory[]
  genres                             Genre[]            @relation("GenreToMangaCustom")
  subscriptionPlansCanReadReleased   SubscriptionPlan[] @relation("MangaCustomToSubscriptionPlanCanReadReleased")
  subscriptionPlansCanReadUnreleased SubscriptionPlan[] @relation("MangaCustomToSubscriptionPlanCanReadUnreleased")
  notifications                      Notification[]
  organizationRecommendations        OrganizationRecommendation[]

  @@unique([mangaId, organizationId])
  @@index([organizationId])
  @@index([organizationId, lastChapterAt])
  @@index([organizationId, views])
  @@index([lastChapterAt])
  @@index([views])
  @@map("manga_custom")
}

model Chapter {
  id                        Int                  @id @default(autoincrement())
  number                    Float
  title                     String               @db.VarChar(256)
  imageUrl                  String?              @db.VarChar(256)
  createdAt                 DateTime             @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime             @updatedAt
  mangaCustomId             Int?
  jointId                   Int?
  uploadedByOrganizationId  Int?
  views                     Int                  @default(0)
  releasedAt                DateTime?            @db.Timestamp(6)
  isUnreleased              Boolean              @default(false)
  deletedAt                 DateTime?
  // Markdown body for text-based chapters (novels, books, etc.). When set,
  // the chapter is rendered by NovelReader and `pages` should be empty.
  bodyMarkdown              String?              @db.Text
  volumeNumber              Int?
  // Numero mostrado (por tomo): permite reiniciar la numeracion por volumen
  // sin romper la identidad global de `number`. Si es null, se muestra `number`.
  displayNumber             Float?
  mangaCustom               MangaCustom?         @relation(fields: [mangaCustomId], references: [id])
  joint                     MangaJoint?          @relation(fields: [jointId], references: [id])
  uploadedByOrganization    Organization?        @relation("ChapterUploader", fields: [uploadedByOrganizationId], references: [id])
  workedByOrganizations     Organization[]       @relation("ChapterWorkedBy")
  pages                     Page[]
  userHistory               UserChapterHistory[]
  pageBookmarks             UserPageBookmark[]
  viewsHistory              ViewsHistory[]
  notifications             Notification[]
  reactions                 ChapterReaction[]

  @@unique([number, mangaCustomId])
  @@unique([number, jointId])
  @@map("chapter")
}

model OrganizationMessageThread {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  userId         Int
  category       String                @db.VarChar(32)
  subject        String                @db.VarChar(200)
  status         String                @default("open") @db.VarChar(16)
  lastMessageAt  DateTime              @default(now())
  createdAt      DateTime              @default(now()) @db.Timestamp(6)
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       OrganizationMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("organization_message_thread")
}

model OrganizationMessage {
  id           Int                        @id @default(autoincrement())
  threadId     Int
  senderUserId Int
  isStaffReply Boolean                    @default(false)
  body         String
  readAt       DateTime?
  createdAt    DateTime                   @default(now()) @db.Timestamp(6)
  thread       OrganizationMessageThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User                       @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("organization_message")
}

model CustomList {
  id          Int              @id @default(autoincrement())
  userId      Int
  name        String           @db.VarChar(60)
  slug        String           @db.VarChar(80)
  description String?          @db.VarChar(500)
  isPublic    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CustomListItem[]
  followers   CustomListFollower[]
  followerItems CustomListFollowerItem[]
  notifications Notification[]

  @@unique([userId, slug])
  @@index([isPublic, updatedAt])
  @@map("custom_list")
}

// "Seguir/suscribirse" a una lista pública: la lista se guarda como lista hija
// del usuario (bookmark) para volver a ella y recibir avisos cuando el dueño la
// actualiza. Gratis para todos (con límite en la capa de aplicación para no
// suscriptores). Crear una lista auto-inserta una fila aquí para el dueño.
model CustomListFollower {
  id        Int        @id @default(autoincrement())
  userId    Int
  listId    Int
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([userId, createdAt])
  @@index([listId])
  @@map("custom_list_follower")
}

// Overlay por-usuario sobre los items de una lista SEGUIDA: el follower no puede
// agregar/quitar obras (la membresía la manda el dueño), pero en "su versión"
// marca su estado de lectura y reordena. Solo existe fila si el follower tocó ese
// item; al renderizar se hace merge con los items de la lista original.
model CustomListFollowerItem {
  id            Int        @id @default(autoincrement())
  userId        Int
  listId        Int
  mangaCustomId Int?
  jointId       Int?
  readingStatus String?    @db.VarChar(32)
  order         Int        @default(0)
