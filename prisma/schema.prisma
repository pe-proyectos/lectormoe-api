generator client {
  provider               = "prisma-client"
  output                 = "../src/prisma-generated"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Token {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("token")
}

model Organization {
  id                                           Int                       @id @default(autoincrement())
  name                                         String                    @db.VarChar(256)
  title                                        String                    @db.VarChar(256)
  domain                                       String                    @unique @db.VarChar(256)
  slug                                         String                    @unique @db.VarChar(256)
  description                                  String?
  imageUrl                                     String?
  createdAt                                    DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                                    DateTime                  @updatedAt
  googleAdsMetaContent                         String?
  googleAdsAdsTxtContent                       String?
  bannerUrl                                    String?
  discordUrl                                   String?
  facebookUrl                                  String?
  instagramUrl                                 String?
  logoUrl                                      String?
  patreonUrl                                   String?
  tiktokUrl                                    String?
  twitchUrl                                    String?
  twitterUrl                                   String?
  youtubeUrl                                   String?
  enableGoogleAds                              Boolean                   @default(false)
  faviconUrl                                   String?
  enableMangaSection                           Boolean                   @default(true)
  enableManhuaSection                          Boolean                   @default(false)
  enableManhwaSection                          Boolean                   @default(false)
  language                                     String                    @default("es") @db.VarChar(2)
  monitorWebsiteId                             String?
  useAllowedCountries                          Boolean                   @default(false)
  useBlockedCountries                          Boolean                   @default(false)
  adsterraAdSource                             String?
  enableAdsterraAds                            Boolean                   @default(false)
  enableMainBanner                             Boolean                   @default(false)
  enableMainSlider                             Boolean                   @default(false)
  enableSubscriptionSection                    Boolean                   @default(false)
  discordWebhookUrlNewChapter                  String?
  discordWebhookUrlNewSubscription             String?
  enableDiscordWebhookNewChapter               Boolean                   @default(false)
  enableDiscordWebhookNewSubscription          Boolean                   @default(false)
  discordWebhookMessageTemplateNewChapter      String?
  discordWebhookMessageTemplateNewSubscription String?
  isPublic                                     Boolean                   @default(true)
  isNSFW                                       Boolean                   @default(true)
  isDeleted                                    Boolean                   @default(false)
  enableAds                                    Boolean                   @default(false)
  analytics                                    Analytics[]
  audits                                       Audit[]
  comments                                     Comment[]
  commentLikes                                 CommentLike[]
  countryOptions                               CountryOptions[]
  genres                                       Genre[]
  mangaCustoms                                 MangaCustom[]
  followers                                    OrganizationFollower[]
  OrganizationTransaction                      OrganizationTransaction[]
  passwordResetTokens                          PasswordResetToken[]
  permissions                                  Permission[]
  rankings                                     Ranking[]
  subscriptions                                Subscription[]
  subscriptionPlans                            SubscriptionPlan[]
  jointMembers                                 JointMember[]
  uploadedJointChapters                        Chapter[]     @relation("ChapterUploader")
  workedOnJointChapters                        Chapter[]     @relation("ChapterWorkedBy")
  notifications                                Notification[]
  jointMemberHistory                           JointMemberHistory[]

  @@map("organization")
}

model User {
  id                      Int                      @id @default(autoincrement())
  username                String                   @unique @db.VarChar(256)
  slug                    String                   @unique @db.VarChar(256)
  email                   String                   @unique @db.VarChar(256)
  password                String                   @db.VarChar(256)
  createdAt               DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                 @updatedAt
  description             String?
  imageUrl                String?
  birthdate               DateTime?
  bannerUrl               String?
  bannerUrlChangedAt      DateTime?
  imageUrlChangedAt       DateTime?
  usernameChangedAt       DateTime?
  emailNotifications      Boolean                  @default(true)
  emailVerified           Boolean                  @default(false)
  isPrivateHistory        Boolean                  @default(false)
  isPublicProfile         Boolean                  @default(true)
  pushNotifications       Boolean                  @default(true)
  notifyCommentsOnOwnedContent Boolean             @default(true)
  // Global no-ads override (admins, giveaway prizes, etc.). Independent of
  // subscriptions — applies on every page regardless of plan / scan.
  hideAds                 Boolean                  @default(false)
  theme                   String                   @default("dark") @db.VarChar(20)
  discordId           String?    @unique @db.VarChar(64)
  discordUsername     String?    @db.VarChar(64)
  discordAvatar       String?    @db.VarChar(64)
  discordVerifiedAt   DateTime?
  discordLastCheckAt  DateTime?
  analytics               Analytics[]
  audits                  Audit[]
  Comment                 Comment[]                @relation("HiddenByUser")
  comments                Comment[]
  emailLogs               EmailLog[]
  emailPreference         EmailPreference?
  emailVerificationTokens EmailVerificationToken[]
  favorites               Favorite[]
  userList                UserList[]
  organizationFollows     OrganizationFollower[]
  passwordResetTokens     PasswordResetToken[]
  permissions             Permission[]
  rankings                Ranking[]
  subscriptions           Subscription[]
  tokens                  Token[]
  unsubscribeTokens       UnsubscribeToken[]
  achievements            UserAchievement[]
  history                 UserChapterHistory[]
  dailyActivities         UserDailyActivity[]
  notifications           Notification[]
  raffleTickets           RaffleTicket[]
  raffleComments          RaffleComment[]

  @@map("user")
}

model Permission {
  id                        Int          @id @default(autoincrement())
  userId                    Int
  organizationId            Int
  canCreateAuthor           Boolean      @default(false)
  canCreateChapter          Boolean      @default(false)
  canCreateGenre            Boolean      @default(false)
  canCreateMangaCustom      Boolean      @default(false)
  canCreateMangaProfile     Boolean      @default(false)
  canCreatePage             Boolean      @default(false)
  canDeleteChapter          Boolean      @default(false)
  canDeleteGenre            Boolean      @default(false)
  canDeleteMangaCustom      Boolean      @default(false)
  canDeleteOrganization     Boolean      @default(false)
  canDeletePage             Boolean      @default(false)
  canEditChapter            Boolean      @default(false)
  canEditGenre              Boolean      @default(false)
  canEditMangaCustom        Boolean      @default(false)
  canEditOrganization       Boolean      @default(false)
  canEditPage               Boolean      @default(false)
  canSeeAdminPanel          Boolean      @default(false)
  hierarchyLevel            Int          @default(0)
  role                      String       @default("user") @db.VarChar(256)
  canDeleteUser             Boolean      @default(false)
  canEditUser               Boolean      @default(false)
  canCreateSubscriptionPlan Boolean      @default(false)
  canDeleteSubscriptionPlan Boolean      @default(false)
  canEditSubscriptionPlan   Boolean      @default(false)
  canDownload               Boolean      @default(false)
  canReadUnreleased         Boolean      @default(false)
  hideAds                   Boolean      @default(false)
  canDeleteComment          Boolean      @default(false)
  canEditComment            Boolean      @default(false)
  canHideComment            Boolean      @default(false)
  createdAt                 DateTime     @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("permission")
}

model PasswordResetToken {
  id             Int           @id @default(autoincrement())
  userId         Int
  token          String        @unique
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("password_reset_token")
}

model CountryOptions {
  id             Int          @id @default(autoincrement())
  organizationId Int
  countryCode    String       @db.VarChar(2)
  language       String       @db.VarChar(2)
  countryName    String       @db.VarChar(256)
  allowed        Boolean      @default(true)
  blocked        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, countryCode])
  @@map("country_options")
}

model Author {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(256)
  slug             String   @unique @db.VarChar(256)
  shortDescription String?  @db.VarChar(300)
  description      String?
  imageUrl         String?
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @updatedAt
  mangas           Manga[]  @relation("AuthorToManga")

  @@map("author")
}

model BookType {
  id                Int     @id @default(autoincrement())
  name              String  @db.VarChar(256)
  default_read_type String?
  code              String  @unique @db.VarChar(256)
  Manga             Manga[]

  @@map("book_type")
}

model Manga {
  id               Int           @id @default(autoincrement())
  demographyId     Int
  title            String        @unique @db.VarChar(256)
  slug             String        @unique @db.VarChar(256)
  shortDescription String?       @db.VarChar(300)
  description      String?
  imageUrl         String?
  releasedAt       DateTime?
  nextChapterAt    DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt
  bannerUrl        String?
  bookTypeId       Int
  bookType         BookType      @relation(fields: [bookTypeId], references: [id])
  demography       Demography    @relation(fields: [demographyId], references: [id])
  custom           MangaCustom[]
  joints           MangaJoint[]
  authors          Author[]      @relation("AuthorToManga")

  @@map("manga")
}

model MangaCustom {
  id                                 Int                @id @default(autoincrement())
  mangaId                            Int
  organizationId                     Int
  title                              String             @db.VarChar(256)
  shortDescription                   String?            @db.VarChar(300)
  description                        String?
  imageUrl                           String?
  releasedAt                         DateTime?
  nextChapterAt                      DateTime?
  createdAt                          DateTime           @default(now()) @db.Timestamp(6)
  updatedAt                          DateTime           @updatedAt
  views                              Int                @default(0)
  lastChapterAt                      DateTime?
  status                             String             @default("ongoing") @db.VarChar(256)
  visibility                         String             @default("public") @db.VarChar(256)
  bannerUrl                          String?
  requireLogin                       Boolean            @default(false)
  isSimulRelease                     Boolean            @default(false)
  isNSFW                             Boolean            @default(false)
  workType                           String             @default("manga") @db.VarChar(32)
  deletedAt                          DateTime?
  nextChapterAtMessage               String?
  usersAlsoReadMangaCustomIds        String?
  chapters                           Chapter[]
  favorites                          Favorite[]
  userListEntries                    UserList[]
  manga                              Manga              @relation(fields: [mangaId], references: [id])
  organization                       Organization       @relation(fields: [organizationId], references: [id])
  rankings                           Ranking[]
  viewsHistory                       ViewsHistory[]
  genres                             Genre[]            @relation("GenreToMangaCustom")
  subscriptionPlansCanReadReleased   SubscriptionPlan[] @relation("MangaCustomToSubscriptionPlanCanReadReleased")
  subscriptionPlansCanReadUnreleased SubscriptionPlan[] @relation("MangaCustomToSubscriptionPlanCanReadUnreleased")
  notifications                      Notification[]

  @@unique([mangaId, organizationId])
  @@index([organizationId])
  @@index([organizationId, lastChapterAt])
  @@index([organizationId, views])
  @@index([lastChapterAt])
  @@index([views])
  @@map("manga_custom")
}

model Chapter {
  id                        Int                  @id @default(autoincrement())
  number                    Float
  title                     String               @db.VarChar(256)
  imageUrl                  String?              @db.VarChar(256)
  createdAt                 DateTime             @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime             @updatedAt
  mangaCustomId             Int?
  jointId                   Int?
  uploadedByOrganizationId  Int?
  views                     Int                  @default(0)
  releasedAt                DateTime?            @db.Timestamp(6)
  isUnreleased              Boolean              @default(false)
  deletedAt                 DateTime?
  // Markdown body for text-based chapters (novels, books, etc.). When set,
  // the chapter is rendered by NovelReader and `pages` should be empty.
  bodyMarkdown              String?              @db.Text
  mangaCustom               MangaCustom?         @relation(fields: [mangaCustomId], references: [id])
  joint                     MangaJoint?          @relation(fields: [jointId], references: [id])
  uploadedByOrganization    Organization?        @relation("ChapterUploader", fields: [uploadedByOrganizationId], references: [id])
  workedByOrganizations     Organization[]       @relation("ChapterWorkedBy")
  pages                     Page[]
  userHistory               UserChapterHistory[]
  viewsHistory              ViewsHistory[]
  notifications             Notification[]

  @@unique([number, mangaCustomId])
  @@unique([number, jointId])
  @@map("chapter")
}

model Page {
  id           Int      @id @default(autoincrement())
  chapterId    Int
  number       Int
  imageUrl     String
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  imageHeight  Int
  imageType    String   @db.VarChar(256)
  imageWidth   Int
  isSinglePage Boolean  @default(false)
  chapter      Chapter  @relation(fields: [chapterId], references: [id])

  @@unique([number, chapterId])
  @@map("page")
}

model Comment {
  id             Int           @id @default(autoincrement())
  organizationId Int
  userId         Int
  parentId       Int?
  identifier     String        @db.VarChar(512)
  comment        String
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  imageUrl       String?
  likesCount     Int           @default(0)
  dislikesCount  Int           @default(0)
  deletedAt      DateTime?
  hiddenAt       DateTime?
  hiddenReason   String?
  hiddenByUserId Int?
  hiddenByUser   User?         @relation("HiddenByUser", fields: [hiddenByUserId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  parent         Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]     @relation("CommentReplies")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes          CommentLike[]
  notifications        Notification[] @relation("NotificationComment")
  parentNotifications  Notification[] @relation("NotificationParentComment")

  @@index([organizationId])
  @@index([userId])
  @@index([identifier])
  @@map("comment")
}

model CommentLike {
  id             Int          @id @default(autoincrement())
  commentId      Int
  userId         Int
  organizationId Int
  like           Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  comment        Comment      @relation(fields: [commentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([commentId, userId, organizationId])
  @@map("comment_like")
}

model Ranking {
  id             Int           @id @default(autoincrement())
  userId         Int?
  rank           String        @db.Char(1)
  comment        String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  mangaCustomId  Int
  organizationId Int?
  mangaCustom    MangaCustom   @relation(fields: [mangaCustomId], references: [id])
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  User           User?         @relation(fields: [userId], references: [id])

  @@map("ranking")
}

model Demography {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(256)
  slug        String   @unique @db.VarChar(256)
  description String
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt
  mangas      Manga[]

  @@map("demography")
}

model Genre {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(256)
  slug           String        @db.VarChar(256)
  description    String
  display        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id])
  mangasCustom   MangaCustom[] @relation("GenreToMangaCustom")

  @@unique([organizationId, slug])
  @@map("genre")
}

model Analytics {
  id             Int           @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  path           String?
  ip             String?
  browser        String?
  deviceType     String?
  payload        Json?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  capturedAt     DateTime      @default(now()) @db.Timestamp(6)
  event          String?
  screenHeight   Int?
  screenWidth    Int?
  userAgent      String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, capturedAt, event])
  @@index([capturedAt])
  @@map("analytics")
}

model UserChapterHistory {
  id         Int       @id @default(autoincrement())
  userId     Int
  chapterId  Int
  startedAt  DateTime?
  lastReadAt DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt
  pageNumber Int?
  chapter    Chapter   @relation(fields: [chapterId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId])
  @@map("user_chapter_history")
}

model Favorite {
  id            Int          @id @default(autoincrement())
  userId        Int
  mangaCustomId Int?
  jointId       Int?
  order         Int          @default(0)
  // When the user marked this entry as finished reading (null = unread/in-progress).
  finishedAt    DateTime?    @db.Timestamp(6)
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime     @updatedAt
  mangaCustom   MangaCustom? @relation(fields: [mangaCustomId], references: [id])
  joint         MangaJoint?  @relation(fields: [jointId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@unique([userId, mangaCustomId])
  @@unique([userId, jointId])
  @@index([userId, order])
  @@map("favorite")
}

// 'Mi lista' — user-curated reading list, separate from favorites.
// Same shape and semantics as Favorite: either a mangaCustom or a joint, ordered.
model UserList {
  id            Int          @id @default(autoincrement())
  userId        Int
  mangaCustomId Int?
  jointId       Int?
  order         Int          @default(0)
  finishedAt    DateTime?    @db.Timestamp(6)
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime     @updatedAt
  mangaCustom   MangaCustom? @relation(fields: [mangaCustomId], references: [id])
  joint         MangaJoint?  @relation(fields: [jointId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@unique([userId, mangaCustomId])
  @@unique([userId, jointId])
  @@index([userId, order])
  @@map("user_list")
}

model Audit {
  id             Int           @id @default(autoincrement())
  action         String        @db.VarChar(256)
  payload        Json?
  ip             String
  browser        String?
  language       String?
  device         String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  userId         Int?
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  User           User?         @relation(fields: [userId], references: [id])

  @@map("audit")
}

model ViewsHistory {
  id            Int          @id @default(autoincrement())
  mangaCustomId Int?
  chapterId     Int?
  jointId       Int?
  ip            String
  viewedAt      DateTime
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime     @updatedAt
  chapter       Chapter?     @relation(fields: [chapterId], references: [id])
  mangaCustom   MangaCustom? @relation(fields: [mangaCustomId], references: [id])
  joint         MangaJoint?  @relation(fields: [jointId], references: [id])

  @@index([mangaCustomId, viewedAt])
  @@index([mangaCustomId, createdAt])
  @@index([jointId, viewedAt])
  @@index([viewedAt])
  @@index([createdAt])
  @@map("views")
}

model SubscriptionPlan {
  id                            Int            @id @default(autoincrement())
  name                          String         @db.VarChar(256)
  description                   String
  price                         Float
  interval                      String         @default("MONTH") @db.VarChar(256)
  currency                      String         @default("USD") @db.VarChar(10)
  planId                        String         @unique @db.VarChar(256)
  createdAt                     DateTime       @default(now()) @db.Timestamp(6)
  updatedAt                     DateTime       @updatedAt
  organizationId                Int
  slug                          String         @unique @db.VarChar(256)
  productId                     String         @unique @db.VarChar(256)
  active                        Boolean        @default(true)
  canDownload                   Boolean        @default(false)
  canReadUnreleased             Boolean        @default(false)
  hideAds                       Boolean        @default(false)
  subscriptions                 Subscription[]
  organization                  Organization   @relation(fields: [organizationId], references: [id])
  mangaCustomsCanReadReleased   MangaCustom[]  @relation("MangaCustomToSubscriptionPlanCanReadReleased")
  mangaCustomsCanReadUnreleased MangaCustom[]  @relation("MangaCustomToSubscriptionPlanCanReadUnreleased")

  @@unique([organizationId, slug])
  @@map("subscription_plan")
}

model Subscription {
  id                   Int                       @id @default(autoincrement())
  userId               Int
  subscriptionPlanId   Int
  status               String                    @default("PENDING") @db.VarChar(256)
  startDate            DateTime
  endDate              DateTime?
  lastPayment          DateTime?
  createdAt            DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt            DateTime                  @updatedAt
  paypalSubscriptionId String                    @db.VarChar(256)
  active               Boolean                   @default(true)
  nextPayment          DateTime?
  cycleExecutions      Int                       @default(0)
  failedPaymentsCount  Int                       @default(0)
  lastAmount           Float?
  organizationId       Int?
  transactions         OrganizationTransaction[]
  organization         Organization?             @relation(fields: [organizationId], references: [id])
  subscriptionPlan     SubscriptionPlan          @relation(fields: [subscriptionPlanId], references: [id])
  user                 User                      @relation(fields: [userId], references: [id])
  notifications        Notification[]

  @@map("subscription")
}

model OrganizationTransaction {
  id               Int           @id @default(autoincrement())
  organizationId   Int
  origin           String
  amount           Float
  currency         String        @default("USD") @db.VarChar(10)
  type             String        @default("EARNING") @db.VarChar(256)
  status           String        @default("PENDING") @db.VarChar(256)
  paymentMethod    String?       @db.VarChar(256)
  paymentDetails   String?
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt
  transactionId    String?       @db.VarChar(256)
  description      String?
  beforeFeesAmount Float
  capibaraFee      Float?
  paypalFee        Float?
  transactionDate  DateTime?
  subscriptionId   Int?
  organization     Organization  @relation(fields: [organizationId], references: [id])
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("organization_transaction")
}

model OrganizationFollower {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_follower")
}

model OrganizationRequest {
  id                      Int      @id @default(autoincrement())
  applicantName           String   @db.VarChar(256)
  applicantEmail          String   @db.VarChar(256)
  scanName                String   @db.VarChar(256)
  references              String
  previousWorks           String
  estimatedMonthlyReaders String   @db.VarChar(50)
  status                  String   @default("pending") @db.VarChar(50)
  reviewNotes             String?
  createdAt               DateTime @default(now()) @db.Timestamp(6)
  updatedAt               DateTime @updatedAt

  @@map("organization_request")
}

model EmailPreference {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  newChapterAlert         Boolean  @default(true)
  newMangaRelease         Boolean  @default(true)
  dailyDigest             Boolean  @default(true)
  weeklyReadingSummary    Boolean  @default(true)
  subscriptionReminders   Boolean  @default(true)
  readingStreakMilestones Boolean  @default(true)
  reEngagement            Boolean  @default(true)
  recommendations         Boolean  @default(true)
  weeklyOrgReport         Boolean  @default(true)
  newSubscriberAlert      Boolean  @default(true)
  revenueAlert            Boolean  @default(true)
  contentPerformance      Boolean  @default(true)
  failedPaymentAlert      Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamp(6)
  updatedAt               DateTime @updatedAt
  commentReplyAlert       Boolean  @default(true)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_preference")
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  emailType String   @db.VarChar(100)
  subject   String   @db.VarChar(500)
  resendId  String?  @db.VarChar(256)
  status    String   @default("sent") @db.VarChar(50)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, emailType, createdAt])
  @@index([createdAt])
  @@map("email_log")
}

model UnsubscribeToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(256)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("unsubscribe_token")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(256)
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_token")
}

model UserDailyActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_daily_activity")
}

model Achievement {
  id               Int               @id @default(autoincrement())
  key              String            @unique @db.VarChar(100)
  title            String            @db.VarChar(256)
  description      String
  emoji            String            @db.VarChar(10)
  category         String            @db.VarChar(50)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  userAchievements UserAchievement[]

  @@index([category])
  @@map("achievement")
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  achievementId Int
  unlockedAt    DateTime    @default(now()) @db.Timestamp(6)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievement")
}

enum JointRole {
  LEADER
  UPLOADER
  VIEWER
}

enum JointMemberStatus {
  INVITED
  ACCEPTED
  REJECTED
  EXPELLED
  LEFT
}

model MangaJoint {
  id               Int           @id @default(autoincrement())
  slug             String        @unique @db.VarChar(256)
  mangaId          Int
  manga            Manga         @relation(fields: [mangaId], references: [id])
  title            String        @default("") @db.VarChar(512)
  shortDescription String?       @db.VarChar(300)
  description      String?
  imageUrl         String?
  bannerUrl        String?
  status           String        @default("ongoing") @db.VarChar(64)
  workType         String        @default("manga") @db.VarChar(64)
  lastChapterAt    DateTime?
  views            Int           @default(0)
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  members          JointMember[]
  chapters         Chapter[]
  viewsHistory     ViewsHistory[]
  favorites        Favorite[]
  userListEntries  UserList[]
  notifications    Notification[]
  memberHistory    JointMemberHistory[]

  @@index([mangaId])
  @@index([lastChapterAt])
  @@map("manga_joint")
}

model JointMember {
  id             Int               @id @default(autoincrement())
  jointId        Int
  joint          MangaJoint        @relation(fields: [jointId], references: [id])
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id])
  role           JointRole         @default(VIEWER)
  status         JointMemberStatus @default(INVITED)
  canEditJoint   Boolean           @default(false)
  canInvite      Boolean           @default(false)
  canExpel       Boolean           @default(false)
  invitedAt      DateTime          @default(now()) @db.Timestamp(6)
  respondedAt    DateTime?         @db.Timestamp(6)

  @@unique([jointId, organizationId])
  @@map("joint_member")
}

model JointMemberHistory {
  id             Int                @id @default(autoincrement())
  jointId        Int
  joint          MangaJoint         @relation(fields: [jointId], references: [id])
  organizationId Int
  organization   Organization       @relation(fields: [organizationId], references: [id])
  fromStatus     JointMemberStatus?
  toStatus       JointMemberStatus
  fromRole       JointRole?
  toRole         JointRole?
  // 'invite' | 'accept' | 'reject' | 'leave' | 'expel' | 'transfer_leadership' | 'auto_promote' | 'auto_dissolve'
  action         String             @db.VarChar(64)
  // userId of the actor that triggered the change. NULL = system / cron.
  actorUserId    Int?
  reason         String?
  createdAt      DateTime           @default(now()) @db.Timestamp(6)

  @@index([jointId, createdAt])
  @@index([organizationId, createdAt])
  @@map("joint_member_history")
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  type          String       @default("new_chapter") @db.VarChar(64)
  // The thing the notification is about. Exactly one of mangaCustomId / jointId
  // is set for new_chapter notifications.
  mangaCustomId Int?
  mangaCustom   MangaCustom? @relation(fields: [mangaCustomId], references: [id])
  jointId       Int?
  joint         MangaJoint?  @relation(fields: [jointId], references: [id])
  chapterId     Int?
  chapter       Chapter?     @relation(fields: [chapterId], references: [id])
  // 'favorite' | 'user_list' | 'reply' | 'org_follower' | 'org_staff' — why this
  // user is being notified. For new_chapter: favorite wins over user_list.
  source        String       @default("favorite") @db.VarChar(32)
  readAt        DateTime?
  createdAt     DateTime     @default(now()) @db.Timestamp(6)

  // null until the cron sends the delayed email. The cron picks rows where
  // readAt IS NULL AND emailSentAt IS NULL AND createdAt < now - 30 min.
  emailSentAt     DateTime?

  // For comment_reply notifications.
  commentId       Int?
  comment         Comment?      @relation("NotificationComment", fields: [commentId], references: [id])
  parentCommentId Int?
  parentComment   Comment?      @relation("NotificationParentComment", fields: [parentCommentId], references: [id])

  // For new_subscriber / failed_payment notifications.
  subscriptionId  Int?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  // For new_manga / new_subscriber / failed_payment — the org context.
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([readAt, emailSentAt, createdAt])
  @@map("notification")
}

model Raffle {
  id                  Int             @id @default(autoincrement())
  slug                String          @unique @db.VarChar(256)
  title               String          @db.VarChar(256)
  description         String?         @db.Text
  imageUrl            String?
  bannerUrl           String?
  ticketPrice         Float           @default(0)
  currency            String          @default("USD") @db.VarChar(8)
  minTickets          Int             @default(1)
  maxTickets          Int
  maxTicketsPerUser   Int             @default(1)
  drawType            String          @db.VarChar(32)
  drawAt              DateTime?
  status              String          @default("active") @db.VarChar(32)
  winnerTicketId      Int?
  winnerUserId        Int?
  revealStartedAt     DateTime?
  revealOrder         Json?
  revealDigits        String?
  // How many surviving tickets at the end of the elimination tournament.
  // Default 1 keeps existing single-winner raffles behaving like before.
  winnersCount        Int             @default(1)
  // Milliseconds between eliminations. Hardcoded UI is 5000 for now but
  // exposed as a column so we can tune per-raffle (or speed up demos) later.
  eliminationIntervalMs Int           @default(5000)
  // Wall-clock of the most recent elimination. Used by clients (polling) to
  // compute "Próxima eliminación en Xs".
  lastEliminationAt   DateTime?
  cancelReason        String?         @db.VarChar(256)
  createdAt           DateTime        @default(now()) @db.Timestamp(6)
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  tickets             RaffleTicket[]
  comments            RaffleComment[]
  refunds             RaffleRefund[]

  @@index([status, drawAt])
  @@map("raffle")
}

model RaffleTicket {
  id                  Int             @id @default(autoincrement())
  raffleId            Int
  raffle              Raffle          @relation(fields: [raffleId], references: [id])
  userId              Int
  user                User            @relation(fields: [userId], references: [id])
  number              Int
  comment             String?         @db.VarChar(500)
  paypalOrderId       String?         @db.VarChar(64)
  paypalCaptureId     String?         @db.VarChar(64)
  amountPaid          Float           @default(0)
  refundedAt          DateTime?
  eliminatedAt        DateTime?
  eliminationOrder    Int?
  createdAt           DateTime        @default(now()) @db.Timestamp(6)
  refund              RaffleRefund?

  @@unique([raffleId, number])
  @@index([raffleId, userId])
  @@map("raffle_ticket")
}

model RaffleComment {
  id          Int       @id @default(autoincrement())
  raffleId    Int
  raffle      Raffle    @relation(fields: [raffleId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  body        String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)

  @@index([raffleId, createdAt])
  @@map("raffle_comment")
}

model RaffleRefund {
  id              Int           @id @default(autoincrement())
  raffleId        Int
  raffle          Raffle        @relation(fields: [raffleId], references: [id])
  raffleTicketId  Int           @unique
  raffleTicket    RaffleTicket  @relation(fields: [raffleTicketId], references: [id])
  userId          Int
  amount          Float
  currency        String        @db.VarChar(8)
  paypalRefundId  String?       @db.VarChar(64)
  status          String        @db.VarChar(32)
  failureReason   String?       @db.VarChar(256)
  createdAt       DateTime      @default(now()) @db.Timestamp(6)

  @@index([userId, createdAt])
  @@map("raffle_refund")
}
