enum JointRole {
  LEADER
  UPLOADER
  VIEWER
}

enum JointMemberStatus {
  INVITED
  ACCEPTED
  REJECTED
  EXPELLED
  LEFT
}

model MangaJoint {
  id               Int           @id @default(autoincrement())
  slug             String        @unique @db.VarChar(256)
  mangaId          Int
  manga            Manga         @relation(fields: [mangaId], references: [id])
  title            String        @default("") @db.VarChar(512)
  shortDescription String?       @db.VarChar(300)
  description      String?
  imageUrl         String?
  bannerUrl        String?
  status           String        @default("ongoing") @db.VarChar(64)
  workType         String        @default("manga") @db.VarChar(64)
  lastChapterAt    DateTime?
  views            Int           @default(0)
  finalChapterNumber Float?
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  volumes          MangaVolume[]
  milestoneAlerts  ChapterMilestoneAlert[]
  reviews          MangaReview[]
  contentReports   ContentReport[]
  customListItems  CustomListItem[]
  members          JointMember[]
  chapters         Chapter[]
  genres           Genre[]       @relation("GenreToMangaJoint")
  viewsHistory     ViewsHistory[]
  favorites        Favorite[]
  userListEntries  UserList[]
  notifications    Notification[]
  memberHistory    JointMemberHistory[]
  organizationRecommendations OrganizationRecommendation[]

  @@index([mangaId])
  @@index([lastChapterAt])
  @@map("manga_joint")
}

model JointMember {
  id             Int               @id @default(autoincrement())
  jointId        Int
  joint          MangaJoint        @relation(fields: [jointId], references: [id])
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id])
  role           JointRole         @default(VIEWER)
  status         JointMemberStatus @default(INVITED)
  canEditJoint   Boolean           @default(false)
  canInvite      Boolean           @default(false)
  canExpel       Boolean           @default(false)
  invitedAt      DateTime          @default(now()) @db.Timestamp(6)
  respondedAt    DateTime?         @db.Timestamp(6)

  @@unique([jointId, organizationId])
  @@map("joint_member")
}

model JointMemberHistory {
  id             Int                @id @default(autoincrement())
  jointId        Int
  joint          MangaJoint         @relation(fields: [jointId], references: [id])
  organizationId Int
  organization   Organization       @relation(fields: [organizationId], references: [id])
  fromStatus     JointMemberStatus?
  toStatus       JointMemberStatus
  fromRole       JointRole?
  toRole         JointRole?
  // 'invite' | 'accept' | 'reject' | 'leave' | 'expel' | 'transfer_leadership' | 'auto_promote' | 'auto_dissolve'
  action         String             @db.VarChar(64)
  // userId of the actor that triggered the change. NULL = system / cron.
  actorUserId    Int?
  reason         String?
  createdAt      DateTime           @default(now()) @db.Timestamp(6)

  @@index([jointId, createdAt])
  @@index([organizationId, createdAt])
  @@map("joint_member_history")
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  type          String       @default("new_chapter") @db.VarChar(64)
  // The thing the notification is about. Exactly one of mangaCustomId / jointId
  // is set for new_chapter notifications.
  mangaCustomId Int?
  mangaCustom   MangaCustom? @relation(fields: [mangaCustomId], references: [id])
  jointId       Int?
  joint         MangaJoint?  @relation(fields: [jointId], references: [id])
  chapterId     Int?
  chapter       Chapter?     @relation(fields: [chapterId], references: [id])
  // Para type='list_updated': la lista de comunidad que se actualizó.
  listId        Int?
  customList    CustomList?  @relation(fields: [listId], references: [id])
  // 'favorite' | 'user_list' | 'reply' | 'org_follower' | 'org_staff' — why this
  // user is being notified. For new_chapter: favorite wins over user_list.
  source        String       @default("favorite") @db.VarChar(32)
  // Texto libre opcional (ej. razón de un content_removed).
  details       String?      @db.VarChar(500)
  readAt        DateTime?
  createdAt     DateTime     @default(now()) @db.Timestamp(6)

  // null until the cron sends the delayed email. The cron picks rows where
  // readAt IS NULL AND emailSentAt IS NULL AND createdAt < now - 30 min.
  emailSentAt     DateTime?

  // For comment_reply notifications.
  commentId       Int?
  comment         Comment?      @relation("NotificationComment", fields: [commentId], references: [id])
  parentCommentId Int?
  parentComment   Comment?      @relation("NotificationParentComment", fields: [parentCommentId], references: [id])

  // For new_subscriber / failed_payment notifications.
  subscriptionId  Int?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  // For new_manga / new_subscriber / failed_payment — the org context.
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  // Interacciones sociales (/socials): el post referido y el actor que la genero.
  // Columnas planas (sin relacion) para evitar renombrar la relacion de usuario.
  postId          Int?
  actorUserId     Int?
  groupKey        String?       @db.VarChar(120)
  actorsCount     Int           @default(1)
  extraActorIds   Json?

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([readAt, emailSentAt, createdAt])
  @@map("notification")
}

model Raffle {
  id                  Int             @id @default(autoincrement())
  slug                String          @unique @db.VarChar(256)
  title               String          @db.VarChar(256)
  description         String?         @db.Text
  imageUrl            String?
  bannerUrl           String?
  ticketPrice         Float           @default(0)
  currency            String          @default("USD") @db.VarChar(8)
  minTickets          Int             @default(1)
  maxTickets          Int
  maxTicketsPerUser   Int             @default(1)
  drawType            String          @db.VarChar(32)
  drawAt              DateTime?
  status              String          @default("active") @db.VarChar(32)
  winnerTicketId      Int?
  winnerUserId        Int?
  revealStartedAt     DateTime?
  revealOrder         Json?
  revealDigits        String?
  // How many surviving tickets at the end of the elimination tournament.
  // Default 1 keeps existing single-winner raffles behaving like before.
  winnersCount        Int             @default(1)
  // Milliseconds between eliminations. Hardcoded UI is 5000 for now but
  // exposed as a column so we can tune per-raffle (or speed up demos) later.
  eliminationIntervalMs Int           @default(5000)
  // Wall-clock of the most recent elimination. Used by clients (polling) to
  // compute "Próxima eliminación en Xs".
  lastEliminationAt   DateTime?
  // Three-phase elimination tournament:
  //   phase1 → 5s eliminations until 30 tickets remain (only if total > 50)
  //   phase2 → Squid-Game wind+lights until 10 remain
  //   phase3_intro → 30s pause before horse race
  //   phase3 → horse race until 1 remains
  drawPhase           String?         @db.VarChar(16)
  // Phase 2 light state ("red" or "green"). Wind gusts during red eliminate.
  lightState          String?         @db.VarChar(8)
  lastLightChangeAt   DateTime?
  lastWindAt          DateTime?
  // Phase 3 timing.
  phase3StartedAt     DateTime?
  lastHorseAdvanceAt  DateTime?
  lastHorseEliminationAt DateTime?
  // Phase 1 "bomb round" state. Bombs are placed on N tickets at a time
  // (default 10), then K of them actually explode (default 5) after a 5s
  // fuse. Stored on the raffle row so late-joining clients can render the
  // current round even if they missed the SSE bomb_placed event.
  phase1BombTicketIds     Json?
  phase1ExplodeTicketIds  Json?
  phase1BombsPlacedAt     DateTime?
  // Set when status flips to "completed". Used to close the live chat
  // 1 hour after the winner is decided so the room doesn't stay open
  // for spam after everyone leaves.
  completedAt             DateTime?
  cancelReason        String?         @db.VarChar(256)
  createdAt           DateTime        @default(now()) @db.Timestamp(6)
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  tickets             RaffleTicket[]
  comments            RaffleComment[]
  refunds             RaffleRefund[]

  @@index([status, drawAt])
  @@map("raffle")
}

model RaffleTicket {
  id                  Int             @id @default(autoincrement())
  raffleId            Int
  raffle              Raffle          @relation(fields: [raffleId], references: [id])
  userId              Int
  user                User            @relation(fields: [userId], references: [id])
  number              Int
  comment             String?         @db.VarChar(500)
  paypalOrderId       String?         @db.VarChar(64)
  paypalCaptureId     String?         @db.VarChar(64)
  amountPaid          Float           @default(0)
  refundedAt          DateTime?
  eliminatedAt        DateTime?
  eliminationOrder    Int?
  // Phase 3 horse-race progress. Higher = further along the track. Reset at
  // phase 3 start. Not used in earlier phases.
  horseSteps          Int             @default(0)
  // Last wall-clock time this ticket was visually moved by a wind gust in
  // phase 2. The FE animates from this; the backend uses it nowhere else.
  blownAt             DateTime?
  createdAt           DateTime        @default(now()) @db.Timestamp(6)
  refund              RaffleRefund?

  @@unique([raffleId, number])
  @@index([raffleId, userId])
  @@map("raffle_ticket")
}

model RaffleComment {
  id          Int       @id @default(autoincrement())
  raffleId    Int
  raffle      Raffle    @relation(fields: [raffleId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  body        String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)

  @@index([raffleId, createdAt])
  @@map("raffle_comment")
}

model RaffleRefund {
  id              Int           @id @default(autoincrement())
  raffleId        Int
  raffle          Raffle        @relation(fields: [raffleId], references: [id])
  raffleTicketId  Int           @unique
  raffleTicket    RaffleTicket  @relation(fields: [raffleTicketId], references: [id])
  userId          Int
  amount          Float
  currency        String        @db.VarChar(8)
  paypalRefundId  String?       @db.VarChar(64)
  status          String        @db.VarChar(32)
  failureReason   String?       @db.VarChar(256)
  createdAt       DateTime      @default(now()) @db.Timestamp(6)

  @@index([userId, createdAt])
  @@map("raffle_refund")
}

enum BanType {
  TEMPORARY
  PERMANENT
  RESTRICTED
}

model UserBan {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  bannedByUserId Int
  type           BanType
  reason         String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  user           User         @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedByUser   User         @relation("BannedByUser", fields: [bannedByUserId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, organizationId])
  @@index([organizationId])
  @@map("user_ban")
}

// Grafo social: seguir usuario-a-usuario.
model UserFollow {
  id         Int      @id @default(autoincrement())
  followerId Int
  followedId Int
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  @@unique([followerId, followedId])
  @@index([followedId, createdAt])
  @@map("user_follow")
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_block")
}

model UserMute {
  id        Int       @id @default(autoincrement())
  muterId   Int
  mutedId   Int
  expiresAt DateTime?
  createdAt DateTime  @default(now()) @db.Timestamp(6)

  @@unique([muterId, mutedId])
  @@map("user_mute")
}

// Encuestas en posts.
model PostPoll {
  id         Int              @id @default(autoincrement())
  postId     Int              @unique
  options    Json
  votesCount Int              @default(0)
  endsAt     DateTime         @db.Timestamp(6)
  createdAt  DateTime         @default(now()) @db.Timestamp(6)
  post       OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes      PostPollVote[]

  @@map("post_poll")
}

model PostPollVote {
  id          Int      @id @default(autoincrement())
  pollId      Int
  userId      Int
  optionIndex Int
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  poll        PostPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@map("post_poll_vote")
}

